{
  "name": "ridehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check server:type-check \"build-only {@}\" --",
    "build:android-web": "npm run type-check && npm run server:type-check && node scripts/build-android-web.mjs",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "server:type-check": "tsc -p tsconfig.server.json",
    "test:server": "tsx --test server/app.test.ts server/weather.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "cap:sync": "cap sync",
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@ionic/vue": "^9.0.11",
    "@ionic/vue-router": "^9.0.11",
    "@neon/config": "^1.14.0",
    "@neondatabase/auth": "^0.7.0-beta",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/functions": "^3.11.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "ionicons": "^8.1.0",
    "jose": "^6.2.17",
    "mapbox-gl": "^3.35.0",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.42",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "html-to-text": "10.0.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
